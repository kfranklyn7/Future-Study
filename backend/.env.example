# Snowflake settings for the Go backend. Copy to backend/.env and fill in your own values.
# .env is gitignored; never commit real credentials.
#
# The backend reads plain environment variables. To load this file in PowerShell:
#   Get-Content .env | Where-Object { $_ -match '^\s*[^#].*=' } | ForEach-Object { $k, $v = $_ -split '=', 2; Set-Item "Env:$($k.Trim())" $v.Trim() }
# In bash/zsh:
#   set -a; source .env; set +a

# Account identifier (ORG-ACCOUNT) and your Snowflake login name.
SNOWFLAKE_ACCOUNT=MSHLTIQ-LHC58802
SNOWFLAKE_USER=your_username

# Password auth (used unless OAuth or SNOWFLAKE_AUTHENTICATOR is set).
SNOWFLAKE_PASSWORD=your_password

# Teammates use SYSADMIN, which has read access to CISC.CORE and usage on COMPUTE_WH.
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CISC
SNOWFLAKE_SCHEMA=CORE

# Optional. Browser SSO only works if the account has a SAML identity provider configured;
# this account does not, so leave it blank.
SNOWFLAKE_AUTHENTICATOR=

# Optional. Path to a file holding an OAuth token; takes precedence over the password.
SNOWFLAKE_TOKEN_FILE_PATH=

# 8000 serves the API and built frontend; use 8001 when running `npm run dev` alongside.
PORT=8001
